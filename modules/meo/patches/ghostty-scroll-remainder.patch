--- a/src/Surface.zig
+++ b/src/Surface.zig
@@ -3432,12 +3432,17 @@
         // We scroll by the number of rows in the offset and save the remainder
         const amount = poff / cell_size;
         assert(@abs(amount) >= 1);
-        self.mouse.pending_scroll_y = poff - (amount * cell_size);
 
         // Round towards zero.
         const delta: isize = @intFromFloat(@trunc(amount));
         assert(@abs(delta) >= 1);
 
+        // Save the sub-row remainder. Note that `amount` is a float, so
+        // `amount * cell_size` is exactly `poff` again -- subtracting it zeroed
+        // the accumulator and discarded up to a full row of accumulated motion
+        // on every emission. Subtract the *truncated* delta instead.
+        self.mouse.pending_scroll_y = poff - (@as(f64, @floatFromInt(delta)) * cell_size);
+
         break :y .{ .delta = delta };
     };
 
@@ -3457,9 +3462,10 @@
 
         const amount = poff / cell_size;
         assert(@abs(amount) >= 1);
-        self.mouse.pending_scroll_x = poff - (amount * cell_size);
         const delta: isize = @intFromFloat(@trunc(amount));
         assert(@abs(delta) >= 1);
+        // Same remainder fix as the y axis above.
+        self.mouse.pending_scroll_x = poff - (@as(f64, @floatFromInt(delta)) * cell_size);
         break :x .{ .delta = delta };
     };
 
